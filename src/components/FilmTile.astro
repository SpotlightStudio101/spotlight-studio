---
import type { FilmEntry } from "../data/films";
import { getLocale, useTranslations } from "../i18n/translations";
import { localizePath } from "../i18n/utils";

interface Props {
  film: FilmEntry;
  delay?: number;
}

const { film, delay = 0 } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const hasClip = Boolean(film.previewClip?.webm || film.previewClip?.mov || film.previewClip?.mp4);
const hasMedia = hasClip || Boolean(film.thumbnail);
---

<a
  href={localizePath(`/films/${film.slug}`, locale)}
  class:list={["group relative block aspect-video w-full overflow-hidden", { "reel-plate": !hasMedia, grain: hasMedia }]}
  data-reveal
  style={`transition-delay:${delay}ms; --beam-delay:${delay * 0.4}ms`}
>
  {
    hasClip && (
      <video
        class="pointer-events-none absolute inset-0 h-full w-full object-cover"
        autoplay
        muted
        playsinline
        preload="auto"
        data-tile-loop
        aria-hidden="true"
      >
        {film.previewClip?.webm && <source src={film.previewClip.webm} type="video/webm" />}
        {film.previewClip?.mov && <source src={film.previewClip.mov} type="video/quicktime" />}
        {film.previewClip?.mp4 && <source src={film.previewClip.mp4} type="video/mp4" />}
      </video>
    )
  }

  {
    !hasClip && film.thumbnail && (
      <img src={film.thumbnail} alt="" class="pointer-events-none absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
    )
  }

  {
    !hasMedia && (
      <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-20 transition-opacity duration-500 group-hover:opacity-40">
        <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
          <circle cx="17" cy="17" r="16" stroke="currentColor" stroke-width="1" class="text-ink" />
          <path d="M14 11.5L23 17L14 22.5V11.5Z" fill="currentColor" class="text-ink" />
        </svg>
      </div>
    )
  }

  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-center justify-between bg-gradient-to-t from-void-deep/70 to-transparent px-4 pb-3 pt-6 md:px-5 md:pb-4">
    <span class="font-display text-[9px] uppercase tracking-tightest text-ash sm:text-xs md:text-sm">
      {t.filmData.genre[film.genre]}
    </span>
    <span class="hidden font-display text-xs uppercase tracking-tightest text-ash-dim sm:inline">
      {film.isDemo ? t.filmTile.demoClip : hasMedia ? "" : t.filmTile.footageComingSoon}
    </span>
  </div>
</a>

<script>
  // Tile clips loop on one shared clock so they all restart at the same instant.
  if (!window.__tileLoopSync) {
    window.__tileLoopSync = true;
    const run = () => {
      const vids = Array.from(document.querySelectorAll<HTMLVideoElement>("video[data-tile-loop]"));
      if (vids.length === 0) return;
      const restart = () => {
        vids.forEach((v) => {
          v.currentTime = 0;
          v.play().catch(() => {});
        });
      };
      let ready = 0;
      const onReady = () => {
        if (++ready === vids.length) restart();
      };
      vids.forEach((v) => {
        v.pause();
        if (v.readyState >= 3) onReady();
        else v.addEventListener("canplaythrough", onReady, { once: true });
        v.addEventListener("ended", () => {
          if (vids.every((x) => x.ended || x.paused)) restart();
        });
      });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run);
    else run();
  }
</script>
