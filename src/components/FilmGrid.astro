---
import { films as allFilms, type FilmEntry } from "../data/films";
import FilmTile from "./FilmTile.astro";

interface Props {
  films?: FilmEntry[];
}

const { films = allFilms } = Astro.props;
---

<div class="grid grid-cols-3 gap-px bg-ash-dim/20">
  {films.map((film, i) => <FilmTile film={film} delay={(i % 3) * 90} />)}
</div>
