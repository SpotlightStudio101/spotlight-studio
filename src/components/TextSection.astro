---
interface Props {
  heading: string;
  paragraphs: string[];
}

const { heading, paragraphs } = Astro.props;
---

<section class="grain-wash border-t border-ash-dim/20 px-6 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-display text-3xl uppercase leading-none tracking-tightest text-ink md:text-5xl">
      {heading}
    </h2>
    <div class="mt-8 flex flex-col gap-5">
      {paragraphs.map((paragraph) => <p class="font-body text-base text-ash md:text-lg" set:html={paragraph} />)}
    </div>
  </div>
</section>
