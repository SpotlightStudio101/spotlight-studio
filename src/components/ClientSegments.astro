---
import { getLocale, useTranslations } from "../i18n/translations";
import { hrefForId } from "../data/landing-utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Each card leads to its dedicated search landing page (by French slug), index-matched to items.
const ids = [
  "video-evenementielle-paris",
  undefined,
  "realisateur-paris",
  "video-entreprise-paris",
  "videaste-mariage-paris",
  "video-immobilier-architecture-paris",
];

// Temporary stock photography (Pexels License, free to use) standing in for Quentin's own
// work until real client stills/footage exist — index-matched to home.segments.items below.
const images = [
  "/images/segments/evenementiel.webp",
  "/images/segments/publicite.webp",
  "/images/segments/documentaire-fiction.webp",
  "/images/segments/entreprises.webp",
  "/images/segments/mariages.webp",
  "/images/segments/architecture.webp",
];
---

<section class="grain-wash relative border-t border-ash-dim/20 px-4 py-20 md:px-10 md:py-32">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-12 font-display text-4xl uppercase italic leading-none tracking-tightest text-ink md:text-6xl">
      {t.home.segments.heading}
    </h2>

    <div class="grid grid-cols-3 gap-2 md:gap-4">
      {
        t.home.segments.items.map((item, i) => {
          const href = ids[i] ? hrefForId(ids[i], locale) : undefined;
          const Tag = href ? "a" : "div";
          return (
          <Tag href={href} class="service-card group flex aspect-[3/4] flex-col justify-end rounded-xl p-2 md:rounded-3xl md:p-6" data-reveal>
            <img src={images[i]} alt="" width="720" height="960" decoding="async" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            <div class="relative z-10 flex flex-col gap-1 md:gap-2">
              <h3 class="font-display text-[11px] uppercase italic leading-[0.95] tracking-tightest text-ink sm:text-base md:text-2xl">
                {item.title}
              </h3>
              <p class="line-clamp-4 max-w-xs font-body text-[8px] leading-tight text-ash sm:text-xs md:line-clamp-2 md:text-sm">{item.body}</p>
            </div>
          </Tag>
          );
        })
      }
    </div>
  </div>
</section>
