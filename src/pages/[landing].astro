---
import LandingView from "../views/LandingView.astro";
import { pagesFor } from "../data/landing-utils";

export function getStaticPaths() {
  return pagesFor("fr").map((page) => ({ params: { landing: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<LandingView page={page} />
