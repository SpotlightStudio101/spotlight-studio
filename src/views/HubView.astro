---
import Layout from "../layouts/Layout.astro";
import { getLocale } from "../i18n/translations";
import { localizePath } from "../i18n/utils";
import { hubHref, landingHref, pagesFor } from "../data/landing-utils";

const locale = getLocale(Astro.currentLocale);
const pages = pagesFor(locale);
const services = pages.filter((p) => p.kind !== "guide");
const guides = pages.filter((p) => p.kind === "guide");

const ui =
  locale === "fr"
    ? {
        title: "Prestations vidéo à Paris : toutes mes offres | Quentin Moulédous",
        description:
          "Toutes les prestations vidéo de Quentin Moulédous à Paris : événementiel, entreprise, mariage, immobilier, drone, captation, production, avec guides et prix.",
        eyebrow: "Prestations · Paris",
        h1: "Mes prestations vidéo à Paris",
        intro:
          "Je suis Quentin Moulédous, vidéaste et réalisateur indépendant à Paris. Voici toutes les prestations que je propose, chacune avec sa page dédiée, ainsi que des guides pour comprendre les prix, les formats et la préparation d'un tournage. Si vous ne savez pas par où commencer, décrivez-moi votre projet : je vous réponds sous 24 h.",
        services: "Prestations",
        guides: "Guides et tarifs",
        quote: "Demander un devis",
        home: "Accueil",
      }
    : {
        title: "Video Services in Paris: All My Offers | Quentin Moulédous",
        description:
          "All of Quentin Moulédous's video services in Paris: events, corporate, weddings, real estate, drone, recording, production, with guides and pricing.",
        eyebrow: "Services · Paris",
        h1: "My video services in Paris",
        intro:
          "I'm Quentin Moulédous, an independent videographer and director in Paris. Here are all the services I offer, each with its own page, along with guides to help you understand prices, formats and how to prepare a shoot. If you don't know where to start, describe your project to me: I'll reply within 24 hours.",
        services: "Services",
        guides: "Guides and pricing",
        quote: "Get a quote",
        home: "Home",
      };
const quoteHref = localizePath("/devis", locale) + "/";
const hubUrl = new URL(hubHref(locale), Astro.site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: ui.home, item: new URL(localizePath("/", locale), Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: ui.h1, item: hubUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: services.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.h1,
      url: new URL(landingHref(p, locale), Astro.site).toString(),
    })),
  },
];
---

<Layout title={ui.title} description={ui.description} jsonLd={jsonLd}>
  <section class="px-6 pb-12 pt-32 md:px-10 md:pb-16 md:pt-44">
    <div class="mx-auto max-w-4xl">
      <p class="mb-6 font-mono text-sm uppercase tracking-normal text-jade">{ui.eyebrow}</p>
      <h1 class="font-display text-4xl uppercase leading-[0.95] tracking-tightest text-ink md:text-6xl">{ui.h1}</h1>
      <p class="mt-8 max-w-2xl font-body text-lg text-ash md:text-xl">{ui.intro}</p>
    </div>
  </section>

  {
    [
      { heading: ui.services, items: services },
      { heading: ui.guides, items: guides },
    ].map((group) => (
      <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
        <div class="mx-auto max-w-4xl">
          <h2 class="mb-8 font-display text-3xl uppercase leading-none tracking-tightest text-ink md:text-5xl">{group.heading}</h2>
          <ul class="flex flex-col">
            {group.items.map((p) => (
              <li class="border-t border-ash-dim/20 py-6 last:border-b">
                <a href={landingHref(p, locale)} class="group flex flex-col gap-2 md:flex-row md:gap-12">
                  <h3 class="font-display text-xl uppercase leading-none tracking-tightest text-jade transition-colors duration-300 group-hover:text-ink md:w-1/3 md:text-2xl">
                    {p.label}
                  </h3>
                  <p class="max-w-xl font-body text-base text-ash md:text-lg">{p.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="border-t border-ash-dim/20 px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto flex max-w-4xl flex-col items-start gap-8">
      <a
        href={quoteHref}
        class="group inline-flex items-center gap-3 rounded-full bg-jade px-7 py-4 font-display text-lg uppercase tracking-tightest text-void-deep transition-transform duration-300 hover:scale-[1.03]"
      >
        {ui.quote}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
          <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
