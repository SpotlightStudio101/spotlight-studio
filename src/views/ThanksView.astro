---
import Layout from "../layouts/Layout.astro";
import { getLocale, useTranslations } from "../i18n/translations";
import { localizePath } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t.meta.thanksTitle} description={t.meta.thanksDescription}>
  <section class="flex min-h-svh flex-col justify-center px-6 py-32 md:px-10">
    <div class="mx-auto flex w-full max-w-3xl flex-col gap-6">
      <h1 class="font-display text-[13vw] uppercase leading-[0.92] tracking-tightest text-ink sm:text-6xl md:text-7xl">
        {t.thanks.heading}
      </h1>
      <p class="max-w-xl font-body text-lg text-ash md:text-xl">
        {t.thanks.body}
      </p>
      <a href={localizePath("/", locale)} class="mt-4 w-fit font-display text-lg uppercase tracking-tightest text-jade hover:text-ink">
        {t.thanks.backHome}
      </a>
    </div>
  </section>
</Layout>
