---
import Layout from "../layouts/Layout.astro";
import FilmGrid from "../components/FilmGrid.astro";
import { films, showCommercial } from "../data/films";
import { getLocale, useTranslations } from "../i18n/translations";
import { hrefForId } from "../data/landing-utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const related = ["aftermovie-paris", "captation-concert-paris", "captation-conference-paris", "video-drone-paris"]
  .map((id) => ({ id, href: hrefForId(id, locale) }))
  .filter((l): l is { id: string; href: string } => Boolean(l.href));
const relatedLabels: Record<string, { fr: string; en: string }> = {
  "aftermovie-paris": { fr: "Aftermovie", en: "Aftermovie" },
  "captation-concert-paris": { fr: "Captation de concert", en: "Concert filming" },
  "captation-conference-paris": { fr: "Captation de conférence", en: "Conference filming" },
  "video-drone-paris": { fr: "Pilote de drone", en: "Drone pilot" },
};

const events = films.filter((film) => film.genre === "event");
const commercial = films.filter((film) => film.genre === "commercial");
---

<Layout title={t.meta.filmsTitle} description={t.meta.filmsDescription}>
  <section class="px-6 pb-10 pt-28 md:px-10 md:pt-32">
    <div class="mx-auto max-w-6xl">
      <h1 class="font-display text-3xl uppercase leading-none tracking-tightest text-ink md:text-4xl">
        {t.films.heading}
      </h1>
    </div>
  </section>

  <section class="px-6 pb-16 md:px-10 md:pb-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-6 font-display text-2xl uppercase leading-none tracking-tightest text-ink md:text-3xl">
        {t.films.eventsHeading}
      </h2>
      <FilmGrid films={events} />
    </div>
  </section>

  <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-8 font-display text-3xl uppercase leading-[0.98] tracking-tightest text-ink md:text-5xl">{t.films.aboutHeading}</h2>
      {t.films.aboutParagraphs.map((p) => <p class="mb-5 max-w-2xl font-body text-base text-ash md:text-lg">{p}</p>)}
      <p class="mt-10 mb-4 font-mono text-sm uppercase tracking-normal text-jade">{t.films.aboutLinks}</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {
          related.map((l) => (
            <li>
              <a href={l.href} class="link-sweep font-mono text-sm uppercase text-ash transition-colors duration-300 hover:text-white">
                {relatedLabels[l.id][locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {showCommercial && (
  <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="mb-6 font-display text-2xl uppercase leading-none tracking-tightest text-ink md:text-3xl">
        {t.films.commercialHeading}
      </h2>
      <FilmGrid films={commercial} />
    </div>
  </section>
  )}
</Layout>
