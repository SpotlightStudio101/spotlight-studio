---
import Layout from "../layouts/Layout.astro";
import type { LandingPage } from "../data/landing-pages";
import { hubHref, landingHref, pageId, pagesFor } from "../data/landing-utils";
import { getLocale } from "../i18n/translations";
import { localizePath } from "../i18n/utils";

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const ui =
  locale === "fr"
    ? { home: "Accueil", quote: "Demander un devis", films: "Voir mes films →", faq: "Questions fréquentes", seeAlso: "Voir aussi", about: "À propos", ctaHeading: "Parlons de votre projet.", ctaText: "Décrivez-moi votre projet en quelques lignes : je vous réponds sous 24 h avec une proposition adaptée, sans engagement.", lang: "fr-FR" }
    : { home: "Home", quote: "Get a quote", films: "See my films →", faq: "Frequently asked questions", seeAlso: "See also", about: "About", ctaHeading: "Let's talk about your project.", ctaText: "Describe your project in a few lines: I'll reply within 24 hours with a tailored, no-obligation proposal.", lang: "en-US" };
const quoteHref = localizePath("/devis", locale) + "/";
const filmsHref = localizePath("/films", locale) + "/";
const aboutHref = localizePath("/about", locale) + "/";
const pageUrl = new URL(landingHref(page, locale), Astro.site).toString();
const allPages = pagesFor(locale);
const related = page.related.map((id) => allPages.find((p) => pageId(p) === id)).filter((p): p is LandingPage => Boolean(p));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: ui.home, item: new URL(localizePath("/", locale), Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: page.label, item: pageUrl },
    ],
  },
  page.kind === "guide"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${pageUrl}#article`,
        headline: page.h1,
        description: page.description,
        inLanguage: ui.lang,
        mainEntityOfPage: pageUrl,
        datePublished: "2026-11-23",
        author: { "@id": new URL("/#quentin", Astro.site).toString() },
        publisher: { "@id": new URL("/#studio", Astro.site).toString() },
      }
    : {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `${pageUrl}#service`,
        name: page.h1,
        serviceType: page.serviceType,
        url: pageUrl,
        inLanguage: ui.lang,
        description: page.description,
        areaServed: [
          { "@type": "City", name: "Paris" },
          { "@type": "AdministrativeArea", name: "Île-de-France" },
          { "@type": "Country", name: "France" },
        ],
        provider: { "@id": new URL("/#studio", Astro.site).toString() },
      },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Layout title={page.title} description={page.description} jsonLd={jsonLd}>
  <section class="px-6 pb-16 pt-32 md:px-10 md:pb-20 md:pt-44">
    <div class="mx-auto max-w-4xl">
      <p class="mb-6 font-mono text-sm uppercase tracking-normal text-jade">{page.eyebrow}</p>
      <h1 class="font-display text-4xl uppercase leading-[0.95] tracking-tightest text-ink md:text-6xl">
        {page.h1}
      </h1>
      <p class="mt-8 max-w-2xl font-body text-lg text-ash md:text-xl">
        {page.intro}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={quoteHref}
          class="group inline-flex items-center gap-3 rounded-full bg-jade px-7 py-4 font-display text-lg uppercase tracking-tightest text-void-deep transition-transform duration-300 hover:scale-[1.03]"
        >
          {ui.quote}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href={filmsHref} class="font-display text-sm uppercase tracking-tightest text-jade hover:text-ink">{ui.films}</a>
      </div>
    </div>
  </section>

  {
    page.sections.map((section) => (
      <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
        <div class="mx-auto max-w-4xl">
          <h2 class="mb-8 font-display text-3xl uppercase leading-[0.98] tracking-tightest text-ink md:text-5xl">{section.h2}</h2>

          {section.paragraphs?.map((paragraph) => <p class="mb-5 max-w-2xl font-body text-base text-ash md:text-lg">{paragraph}</p>)}

          {section.items && (
            <ul class="mt-8 flex flex-col">
              {section.items.map((item) => (
                <li class="border-t border-ash-dim/20 py-8 last:border-b">
                  <div class="flex flex-col gap-3 md:flex-row md:gap-12">
                    <h3 class="font-display text-xl uppercase leading-none tracking-tightest text-jade md:w-1/3 md:text-2xl">
                      {item.href ? (
                        <a href={item.href} class="hover:text-ink">
                          {item.h3}
                        </a>
                      ) : (
                        item.h3
                      )}
                    </h3>
                    <p class="max-w-xl font-body text-base text-ash md:text-lg">{item.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    ))
  }

  <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-10 font-display text-3xl uppercase leading-none tracking-tightest text-ink md:text-5xl">{ui.faq}</h2>
      <div class="flex flex-col">
        {
          page.faq.map((item, i) => (
            <details class="faq-item group border-t border-ash-dim/20 py-6 last:border-b">
              <summary class="flex cursor-pointer list-none items-center gap-4 font-display text-lg uppercase tracking-tightest text-ink md:text-xl">
                <span class="shrink-0 text-jade">{String(i + 1).padStart(2, "0")}</span>
                <span class="flex-1">{item.question}</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0 text-jade transition-transform duration-300 group-open:rotate-45">
                  <path d="M8 2V14M2 8H14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </summary>
              <p class="mt-4 max-w-2xl pl-[2.75rem] font-body text-base text-ash md:text-lg">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-ash-dim/20 px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-8 font-display text-2xl uppercase leading-none tracking-tightest text-ink md:text-3xl">{ui.seeAlso}</h2>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {
          related.map((p) => (
            <li>
              <a href={landingHref(p, locale)} class="link-sweep font-mono text-sm uppercase text-ash transition-colors duration-300 hover:text-white">
                {p.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={hubHref(locale)} class="link-sweep font-mono text-sm uppercase text-jade transition-colors duration-300 hover:text-white">{locale === "fr" ? "Toutes les prestations" : "All services"}</a>
        </li>
        <li>
          <a href={aboutHref} class="link-sweep font-mono text-sm uppercase text-ash transition-colors duration-300 hover:text-white">{ui.about}</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="border-t border-ash-dim/20 px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto flex max-w-4xl flex-col items-start gap-8">
      <h2 class="font-display text-4xl uppercase leading-none tracking-tightest text-ink md:text-6xl">{ui.ctaHeading}</h2>
      <p class="max-w-xl font-body text-base text-ash md:text-lg">
        {ui.ctaText}
      </p>
      <a
        href={quoteHref}
        class="group inline-flex items-center gap-3 rounded-full bg-jade px-7 py-4 font-display text-lg uppercase tracking-tightest text-void-deep transition-transform duration-300 hover:scale-[1.03]"
      >
        {ui.quote}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">
          <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .faq-item summary {
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
