# Hashed build output (fonts, CSS, JS) never changes under the same name: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and videos: a week. Replaced media gets a new file name (-v2, -v3...), never the old one.
/images/*
  Cache-Control: public, max-age=604800
/video/*
  Cache-Control: public, max-age=604800
